DATABASE_URL=postgresql+psycopg://bot_social:bot_social@localhost:5432/bot_social
MODERATOR_GROUP_NAME=moderator
# Optional: a Pydantic AI model name with native web search, such as openai:gpt-6.1-sol
# BOT_SOCIAL_MODEL=
# BOT_SOCIAL_RESEARCH_MODEL=
# BOT_SOCIAL_REVIEW_MODEL=
# BOT_SOCIAL_EDITORIAL_MODEL=
# Uncomment for the optional development tracing stack:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Optional local debugging only: includes prompts, completions, and tool content in traces.
# BOT_SOCIAL_TRACE_CONTENT=true

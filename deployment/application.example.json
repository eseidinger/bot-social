{
  "apiVersion": "platform.eseidinger.de/v1",
  "kind": "Application",
  "metadata": {
    "name": "bot-social"
  },
  "spec": {
    "components": [
      {
        "name": "web",
        "type": "service",
        "runtime": {
          "type": "container",
          "image": "eseidinger/bot-social:latest",
          "command": [
            "python",
            "-m",
            "bot_social.deployment",
            "serve"
          ]
        },
        "ports": [
          {
            "name": "http",
            "protocol": "http",
            "port": 8080
          }
        ],
        "exposure": "public",
        "replicas": 1,
        "bindings": [
          {
            "bindingId": "11111111-1111-1111-1111-111111111111"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "256Mi"
          },
          "limits": {
            "cpu": "500m",
            "memory": "512Mi"
          }
        },
        "health": {
          "readiness": {
            "path": "/health/ready"
          }
        },
        "telemetry": {
          "tracing": {
            "enabled": true
          }
        }
      },
      {
        "name": "worker",
        "type": "service",
        "runtime": {
          "type": "container",
          "image": "eseidinger/bot-social:latest",
          "command": [
            "python",
            "-m",
            "bot_social.deployment",
            "worker"
          ]
        },
        "bindings": [
          {
            "bindingId": "22222222-2222-2222-2222-222222222222"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "256Mi"
          },
          "limits": {
            "cpu": "1",
            "memory": "1Gi"
          }
        },
        "telemetry": {
          "tracing": {
            "enabled": true
          }
        },
        "outbound": []
      }
    ],
    "configuration": {
      "values": {
        "MODERATOR_GROUP_NAME": "moderator"
      }
    }
  }
}
